/* =========================================================================
   DEMONSTRATION OF EXACT BASIS VECTORS, MASTER FIELD, AND CONSTANTS
   File: public/maxima/demo_constants.mac
   ========================================================================= */

load("public/maxima/iris.mac")$

print("-------------------------------------------------------------------")$
print("1. EXACT BASIS VECTORS & NULL CONFORMAL GENERATORS")$
print("-------------------------------------------------------------------")$
disp("e1 . e1 = ", ratsimp(e1 . e1))$
disp("e2 . e2 = ", ratsimp(e2 . e2))$
disp("e3 . e3 = ", ratsimp(e3 . e3))$
disp("e4 . e4 (Degenerate / Null Temporal Aperture Generator) = ", ratsimp(e4 . e4))$
disp("e_plus . e_plus = ", ratsimp(e_plus . e_plus))$
disp("e_minus . e_minus = ", ratsimp(e_minus . e_minus))$
disp("e_inf . e_inf (Null Infinity) = ", ratsimp(e_inf . e_inf))$
disp("e_0 . e_0 (Null Origin) = ", ratsimp(e_0 . e_0))$
disp("cl_dot(e_0, e_inf) = ", cl_dot(e_0, e_inf))$

print("-------------------------------------------------------------------")$
print("2. MASTER FIELD EQUATION CONSTRUCTORS")$
print("-------------------------------------------------------------------")$
F_field: make_F_total(Ex, Ey, Ez, Bx, By, Bz, c)$
disp("F_total = E * e4 + c * B * (e1 ^ e2 ^ e3) : ", F_field)$
U_vec: make_velocity_4vector(ux, uy, uz, c)$
disp("Velocity 4-vector U = u + c * e4 : ", U_vec)$
J_field: make_J_total(rho_0, ux, uy, uz, c)$
disp("Current J_total = rho_0 * U : ", J_field)$

print("-------------------------------------------------------------------")$
print("3. POYNTING MOMENTUM FLUX & ANTENNA RADIATION PRESSURE")$
print("-------------------------------------------------------------------")$
S_vec: poynting_vector(0, Ey, 0, 0, 0, Bz, mu0)$
disp("Poynting Flux Vector S = ", S_vec)$
Prad: radiation_pressure(S_vec[1], c)$
disp("Radiation Pressure P_rad = S / c = ", Prad)$

print("-------------------------------------------------------------------")$
print("4. PROTON-TO-ELECTRON MASS RATIO DERIVATION (m_p / m_e = 6 * pi^5)")$
print("-------------------------------------------------------------------")$
mp_me_exact: proton_electron_mass_ratio()$
disp("Exact Rational Value: ", mp_me_exact)$
disp("Numerical Evaluation: ", float(mp_me_exact))$

print("-------------------------------------------------------------------")$
print("5. MSRA DISCRETE DIFFERENCE QUOTIENT ON GRID G_omega")$
print("-------------------------------------------------------------------")$
f_quad: x^2$
disp("Discrete difference quotient of x^2: ", msra_diff(f_quad, x, omega))$
disp("Main scale projection (downarrow) at scale limit: ", iris_downarrow(subst(1/omega = 0, msra_diff(f_quad, x, omega))))$
