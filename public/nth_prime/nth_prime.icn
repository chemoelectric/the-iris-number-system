# nth_prime.icn
# Sub-linear n-th prime extraction procedure in Icon
# Author: Frédéric Blondin Custer

procedure compute_nth_prime_sieve(n)
   local r_n
   local ln_n
   local ln_ln_n
   local est
   local limit
   local num_odds
   local sieve
   local sq_lim
   local i
   local p
   local start_idx
   local step
   local idx
   local count
   local res
   local found

   r_n := real(n)
   ln_n := log(r_n)
   ln_ln_n := log(ln_n)
   est := r_n * (ln_n + ln_ln_n)
   limit := integer(est * 1.25) + 500

   num_odds := (limit - 1) / 2
   sieve := list(num_odds, 1)

   sq_lim := integer(sqrt(real(limit)))
   i := 1
   while (2 * i + 1) <= sq_lim do {
      if sieve[i] = 1 then {
         p := 2 * i + 1
         start_idx := (p * p - 1) / 2
         step := p
         idx := start_idx
         while idx <= num_odds do {
            sieve[idx] := 0
            idx := idx + step
         }
      }
      i := i + 1
   }

   count := 1
   res := 2
   found := 0
   i := 1
   while (i <= num_odds) & (found = 0) do {
      if sieve[i] = 1 then {
         count := count + 1
         if count = n then {
            res := 2 * i + 1
            found := 1
         }
      }
      i := i + 1
   }

   return res
end

procedure nth_prime(n)
   local res
   local val_n

   val_n := integer(n)
   if val_n < 1 then {
      res := 0
   } else if val_n = 1 then {
      res := 2
   } else if val_n = 2 then {
      res := 3
   } else if val_n = 3 then {
      res := 5
   } else if val_n = 4 then {
      res := 7
   } else {
      res := compute_nth_prime_sieve(val_n)
   }

   return res
end
